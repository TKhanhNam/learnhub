# ==============================================================================
# LearnHub - Mau bien moi truong cau hinh tren Render (giong bai lab huong dan)
# ==============================================================================

APP_NAME=learnhub
APP_ENV=production
PORT=10000

# Thong tin ket noi co so du lieu MySQL tren Aiven (hoac Cloud MySQL)
# Lay tu trang tong quan dich vu Aiven MySQL
DB_HOST=mysql-xxxxxxxx-your-project.aivencloud.com
DB_PORT=16933
DB_DATABASE=identity_db
DB_USER=avnadmin
DB_PASSWORD=YOUR_AIVEN_PASSWORD_HERE

# Chung chi SSL CA cua Aiven (tao trong muc Secret Files tren Render dat ten la ca.pem)
# Duong dan mac dinh tren Render se la /etc/secrets/ca.pem
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

# Khoa bi mat cho JWT va giao tiep noi bo giua cac service
JWT_SECRET=LearnHub-Production-Secret-Key-2026-Super-Secure-Random
INTERNAL_KEY=learnhub-internal-key-2026

# Tuy chon model AI Care hoac tro ly neu dung (assist-service)
# ASSIST_AI_MODEL_GROQ=openai/gpt-oss-120b
