          ] } }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}/catalog/courses/{{courseId}}",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"{{courseTitle}}\",\n  \"subtitle\": \"Da cap nhat\",\n  \"categoryId\": {{categoryId}},\n  \"price\": 199000,\n  \"level\": \"BEGINNER\",\n  \"skills\": [\"Java\", \"Spring Boot\", \"REST API\"]\n}" }
          }
        },
        {
          "name": "Danh sach khoa cua giang vien",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const id = Number(pm.collectionVariables.get('courseId'));",
            "pm.test('Co khoa vua tao', () => pm.expect(pm.response.json().data.map(c => c.id)).to.include(id));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/catalog/instructor/courses"
          }
        },
        {
          "name": "[Loi] Khach xem khoa DRAFT -> 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/catalog/courses/{{courseId}}" }
        }
      ]
    },
