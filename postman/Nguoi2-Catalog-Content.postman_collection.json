      "name": "00 - Dang nhap",
      "item": [
        {
          "name": "Dang nhap giang vien teacher1",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data;",
            "pm.test('Role la INSTRUCTOR', () => pm.expect(d.role).to.eql('INSTRUCTOR'));",
            "pm.collectionVariables.set('teacherToken', d.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"teacher1\",\n  \"password\": \"teacher123\",\n  \"human\": true\n}" }
          }
        },
        {
          "name": "Dang nhap admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
