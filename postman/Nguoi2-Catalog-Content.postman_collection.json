            "pm.test('Role la ADMIN', () => pm.expect(d.role).to.eql('ADMIN'));",
            "pm.collectionVariables.set('adminToken', d.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\",\n  \"human\": true\n}" }
