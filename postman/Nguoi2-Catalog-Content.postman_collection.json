    {
      "name": "01 - Use case Tim khoa hoc (public)",
      "item": [
        {
          "name": "Lay danh sach danh muc",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const list = pm.response.json().data;",
            "pm.test('Co it nhat 1 danh muc', () => pm.expect(list.length).to.be.above(0));",
            "pm.collectionVariables.set('categoryId', list[0].id);"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/catalog/categories" }
        },
        {
          "name": "Tim khoa hoc theo tu khoa",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const list = pm.response.json().data;",
            "pm.test('Tra ve danh sach', () => pm.expect(list).to.be.an('array'));",
            "pm.test('Chi tra khoa PUBLISHED', () => list.forEach(c => pm.expect(c.status).to.eql('PUBLISHED')));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/catalog/courses?keyword=java&page=0&size=5" }
        },
        {
          "name": "Loc theo danh muc + khoang gia + sap xep",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const list = pm.response.json().data;",
            "pm.test('Gia nam trong khoang 0 - 2.000.000', () => list.forEach(c => pm.expect(Number(c.price)).to.be.within(0, 2000000)));",
            "if (list.length > 0) pm.collectionVariables.set('seedSlug', list[0].slug);"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/catalog/courses?category=lap-trinh&minPrice=0&maxPrice=2000000&sort=price,asc" }
        },
        {
          "name": "Xem chi tiet khoa hoc theo slug",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Dung slug', () => pm.expect(pm.response.json().data.slug).to.eql(pm.collectionVariables.get('seedSlug')));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/catalog/courses/{{seedSlug}}" }
        },
        {
          "name": "Khoa ban chay va ky nang thinh hanh",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/catalog/best-sellers?limit=5" }
        },
        {
          "name": "[Loi] Danh muc khong ton tai -> 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
            "pm.test('success = false', () => pm.expect(pm.response.json().success).to.eql(false));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/catalog/courses?category=khong-ton-tai" }
        }
      ]
    },
