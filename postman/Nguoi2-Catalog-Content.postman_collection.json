            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/catalog/courses/{{courseSlug}}" }
        },
        {
          "name": "Tim thay khoa moi trong ket qua tim kiem",
          "event": [{ "listen": "test", "script": { "exec": [
            "const id = Number(pm.collectionVariables.get('courseId'));",
            "pm.test('Co khoa vua duyet', () => pm.expect(pm.response.json().data.map(c => c.id)).to.include(id));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/catalog/courses?keyword={{courseTitle}}" }
        },
        {
          "name": "[Loi] Gui duyet khoa da phat hanh -> 409",
