              "pm.collectionVariables.set('courseSlug', d.slug);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": "{{baseUrl}}/catalog/courses",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"{{courseTitle}}\",\n  \"subtitle\": \"Khoa hoc tao tu Postman\",\n  \"description\": \"Mo ta khoa hoc test\",\n  \"categoryId\": {{categoryId}},\n  \"price\": 299000,\n  \"level\": \"BEGINNER\",\n  \"language\": \"vi\",\n  \"skills\": [\"Java\", \"Spring Boot\"],\n  \"aiAssistEnabled\": true\n}" }
          }
        },
        {
          "name": "Cap nhat khoa hoc",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
