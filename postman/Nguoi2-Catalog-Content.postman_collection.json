            "pm.test('Co so khoa PUBLISHED', () => pm.expect(pm.response.json().data.published).to.be.above(0));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/catalog/admin/stats"
