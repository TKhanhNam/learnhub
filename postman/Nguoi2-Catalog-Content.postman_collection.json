            "pm.test('Khoa nam trong danh sach PENDING', () => pm.expect(pm.response.json().data.map(c => c.id)).to.include(id));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/catalog/admin/courses?status=PENDING&size=100"
