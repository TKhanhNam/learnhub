{
  "info": {
    "name": "LearnHub - Nguoi 1 - Cong vao, tai khoan va to chuc",
    "description": "Kich ban test api-gateway, identity-service (identity_db) va org-service qua API Gateway cong 8080. Chay theo thu tu tu tren xuong (Run collection). Can chay: identity-service 8081, org-service 8087, api-gateway 8080; request 'Cap khoa hoc' can them learning-service 8083.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "courseId", "value": "1" },
    { "key": "adminToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "orgToken", "value": "" },
    { "key": "newUser", "value": "" },
    { "key": "newUserId", "value": "" },
    { "key": "newToken", "value": "" },
    { "key": "newRefresh", "value": "" },
    { "key": "oldRefresh", "value": "" },
    { "key": "rotatedRefresh", "value": "" },
    { "key": "verifyToken", "value": "" },
    { "key": "orgId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - API Gateway",
      "item": [
        {
          "name": "Goi API can dang nhap ma khong co token -> 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
            "pm.test('Gateway tra envelope loi', () => pm.expect(pm.response.json().success).to.eql(false));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/users/me" }
        },
        {
          "name": "Goi duong dan /internal/ tu ngoai -> 403",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/users/internal/abc" }
        },
        {
          "name": "Route public GET /org/plans khong can token -> 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Co 3 goi', () => pm.expect(pm.response.json().data.length).to.eql(3));",
            "pm.test('Co header X-Trace-Id', () => pm.response.to.have.header('X-Trace-Id'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/org/plans" }
        }
      ]
    },
    {
      "name": "02 - Use case Dang ky",
      "item": [
        {
          "name": "Dang ky tai khoan hoc vien moi -> 201",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('newUser', 'tester' + Date.now());"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const d = pm.response.json().data;",
              "pm.test('Role mac dinh STUDENT', () => pm.expect(d.role).to.eql('STUDENT'));",
              "pm.test('Co access + refresh token', () => { pm.expect(d.accessToken).to.be.a('string'); pm.expect(d.refreshToken).to.be.a('string'); });",
              "pm.test('Email chua xac thuc', () => pm.expect(d.emailVerified).to.eql(false));",
              "pm.test('Refresh token dat trong cookie HttpOnly', () => pm.expect(pm.response.headers.get('Set-Cookie') || '').to.include('HttpOnly'));",
              "pm.collectionVariables.set('newUserId', d.userId);",
              "pm.collectionVariables.set('newToken', d.accessToken);",
              "pm.collectionVariables.set('newRefresh', d.refreshToken);",
              "if (d.devVerifyUrl) { pm.collectionVariables.set('verifyToken', d.devVerifyUrl.split('token=')[1]); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{newUser}}\",\n  \"email\": \"{{newUser}}@test.vn\",\n  \"fullName\": \"Nguoi Test\",\n  \"password\": \"test123\",\n  \"role\": \"STUDENT\"\n}" }
          }
        },
        {
          "name": "Dang ky trung username -> 409",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{newUser}}\",\n  \"email\": \"khac{{newUser}}@test.vn\",\n  \"fullName\": \"Trung ten\",\n  \"password\": \"test123\"\n}" }
          }
        },
        {
          "name": "Dang ky trung email -> 409",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"khac{{newUser}}\",\n  \"email\": \"{{newUser}}@test.vn\",\n  \"fullName\": \"Trung email\",\n  \"password\": \"test123\"\n}" }
          }
        },
        {
          "name": "Dang ky sai email + mat khau ngan -> 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('Co danh sach loi validate', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"a\",\n  \"email\": \"khong-phai-email\",\n  \"fullName\": \"\",\n  \"password\": \"1\"\n}" }
          }
        },
        {
          "name": "Tu dang ky vai tro ADMIN -> 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"hack{{newUser}}\",\n  \"email\": \"hack{{newUser}}@test.vn\",\n  \"fullName\": \"Hacker\",\n  \"password\": \"test123\",\n  \"role\": \"ADMIN\"\n}" }
          }
        }
      ]
    },
    {
      "name": "03 - Use case Dang nhap & JWT",
      "item": [
        {
          "name": "Dang nhap sai mat khau -> 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"sai-mat-khau\",\n  \"human\": true\n}" }
          }
        },
        {
          "name": "Dang nhap khong xac nhan 'Toi la nguoi' -> 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"student123\"\n}" }
          }
        },
        {
          "name": "Dang nhap hoc vien student1 -> 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data;",
            "pm.test('Role la STUDENT', () => pm.expect(d.role).to.eql('STUDENT'));",
            "pm.test('Access token la JWT 3 phan', () => pm.expect(d.accessToken.split('.').length).to.eql(3));",
            "pm.collectionVariables.set('studentToken', d.accessToken);",
            "pm.collectionVariables.set('oldRefresh', d.refreshToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"student123\",\n  \"human\": true\n}" }
          }
        },
        {
          "name": "Dang nhap bang email thay username -> 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"student1@learnhub.vn\",\n  \"password\": \"student123\",\n  \"human\": true\n}" }
          }
        },
        {
          "name": "Lay thong tin ca nhan bang JWT -> 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data;",
            "pm.test('Dung tai khoan student1', () => pm.expect(d.username).to.eql('student1'));",
            "pm.test('Khong lo password hash', () => pm.expect(d).to.not.have.property('passwordHash'));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Token gia mao -> 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer abc.def.ghi" }],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "STUDENT goi API ADMIN -> 403",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/users/admin/stats"
          }
        },
        {
          "name": "Refresh token cap token moi -> 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data;",
            "pm.test('Refresh token moi khac token cu', () => pm.expect(d.refreshToken).to.not.eql(pm.collectionVariables.get('oldRefresh')));",
            "pm.collectionVariables.set('rotatedRefresh', d.refreshToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{oldRefresh}}\"\n}" }
          }
        },
        {
          "name": "Dung lai refresh token cu (da xoay vong) -> 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{oldRefresh}}\"\n}" }
          }
        },
        {
          "name": "Dang xuat -> 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{rotatedRefresh}}\"\n}" }
          }
        },
        {
          "name": "Refresh sau khi dang xuat -> 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{rotatedRefresh}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "04 - Use case Xac thuc email",
      "item": [
        {
          "name": "Dang nhap admin -> 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data;",
            "pm.test('Role la ADMIN', () => pm.expect(d.role).to.eql('ADMIN'));",
            "pm.collectionVariables.set('adminToken', d.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\",\n  \"human\": true\n}" }
          }
        },
        {
          "name": "Admin xem nhat ky mail (lay link xac thuc) -> 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "if (!pm.collectionVariables.get('verifyToken')) {",
            "  const uid = Number(pm.collectionVariables.get('newUserId'));",
            "  const mail = pm.response.json().data.find(m => m.relatedUserId === uid && /verify-email\\?token=/.test(m.body || ''));",
            "  if (mail) { pm.collectionVariables.set('verifyToken', mail.body.match(/verify-email\\?token=([^\\s\"<&]+)/)[1]); }",
            "}",
            "pm.test('Lay duoc token xac thuc email', () => pm.expect(pm.collectionVariables.get('verifyToken')).to.not.be.empty);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/users/admin/mail-log?size=30"
          }
        },
        {
          "name": "Xac thuc email bang token -> 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/verify-email?token={{verifyToken}}" }
        },
        {
          "name": "Kiem tra emailVerified = true",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('emailVerified = true', () => pm.expect(pm.response.json().data.emailVerified).to.eql(true));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{newToken}}" }],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Token xac thuc sai -> 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/verify-email?token=token-sai" }
        }
      ]
    },
    {
      "name": "05 - Use case Khoa tai khoan",
      "item": [
        {
          "name": "STUDENT khong duoc khoa nguoi khac -> 403",
